FROM python:3.11-slim AS runtime
WORKDIR /app
ENV PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MODEL_PATH=/app/checkpoints/classifier_v1.pt

COPY requirements/serve.txt /tmp/serve.txt
RUN pip install --no-cache-dir -r /tmp/serve.txt \
    && useradd --create-home --uid 10001 appuser
COPY --chown=appuser:appuser src/model.py src/serve.py ./src/
RUN mkdir -p /app/checkpoints && chown -R appuser:appuser /app
USER appuser
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=2)" || exit 1
CMD ["uvicorn", "serve:app", "--app-dir", "/app/src", "--host", "0.0.0.0", "--port", "8080"]
